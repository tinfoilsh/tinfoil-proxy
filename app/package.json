{
  "name": "tinfoil-proxy",
  "productName": "Tinfoil Proxy",
  "version": "0.2.7",
  "private": true,
  "description": "Verified Tinfoil HTTP proxy and the menu-bar app that wraps it",
  "author": {
    "name": "Tinfoil",
    "email": "support@tinfoil.sh",
    "url": "https://tinfoil.sh"
  },
  "homepage": "https://tinfoil.sh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tinfoilsh/tinfoil-proxy.git"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "build:cli": "bash scripts/build-cli.sh",
    "dev": "npm run build:cli && electron-vite dev",
    "build": "npm run build:cli && electron-vite build",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "package:mac": "npm run build && electron-builder --mac pkg dmg zip --universal",
    "package:mac:dev": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 -c.mac.notarize=false -c.mac.hardenedRuntime=false",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@freedomofpress/sigstore-browser": "^0.1.15",
    "@tinfoilsh/verifier": "^1.2.2",
    "electron-updater": "^6.8.9",
    "snappyjs": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@types/snappyjs": "^0.7.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
